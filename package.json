{
  "name": "luckfox-kvm-matrix",
  "version": "1.4.1",
  "private": true,
  "description": "Vue and TypeScript dashboard for LuckFox PicoKVM devices and host agents.",
  "scripts": {
    "dev": "concurrently \"npm:server:dev\" \"npm:client\"",
    "client": "vite --host 0.0.0.0",
    "server:dev": "tsx watch server/index.ts",
    "server": "node dist-server/index.js",
    "clean": "node scripts/clean-build.mjs",
    "build": "npm run clean && npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview --host 0.0.0.0",
    "type-check": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "start": "npm run build && npm run start:built",
    "start:built": "node dist-server/index.js"
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "26.1.1",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/test-utils": "2.4.11",
    "@vue/vue3-jest": "29.2.6",
    "babel-jest": "29.7.0",
    "concurrently": "10.0.3",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vue": "3.5.39",
    "vue-tsc": "3.3.7"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
