{
  "name": "luckfox-kvm-matrix",
  "version": "1.3.7",
  "private": true,
  "description": "Matrix themed Vue/TypeScript dashboard for LuckFox PicoKVM and host-agent-only devices.",
  "scripts": {
    "dev": "concurrently \"npm:server:dev\" \"npm:client\"",
    "client": "vite --host 0.0.0.0",
    "server:dev": "tsx watch server/index.ts",
    "server": "node dist-server/index.js",
    "build": "npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview --host 0.0.0.0",
    "type-check": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "start": "node dist-server/index.js"
  },
  "dependencies": {
    "express": "latest"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@types/express": "latest",
    "@types/jest": "^29.5.12",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "latest",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.6",
    "babel-jest": "^29.7.0",
    "concurrently": "latest",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vue": "latest",
    "vue-tsc": "latest"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
